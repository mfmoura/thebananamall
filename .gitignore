# Dependencias instaladas pelos gerenciadores de pacotes
/vendor/
/node_modules/

# Configuracao local e credenciais
.env
.env.*
!.env.example
auth.json

# Estado local do Docker
/.docker/db-data/
/.docker/postgres-data/

# Cache compilado pelo Laravel
/bootstrap/cache/*.php

# Arquivos de runtime e dados gerados pelo Laravel
/database/*.sqlite
/storage/*.key
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*.php
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail

# Assets compilados
/public/build/
/public/hot
/public/storage

# Relatorios e caches de testes
/.phpunit.cache/
/.phpunit.result.cache
/coverage/

# Logs e arquivos temporarios de ferramentas
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/.phpactor.json

# Arquivos locais de sistema e IDE
.DS_Store
Thumbs.db
/.idea/
/.vscode/

# Estado de publicacao exclusivo do servidor
/.deploy/
/docker-compose.override.yaml
/docker-compose.deploy.yaml

# Credenciais, certificados e ferramentas locais
/.codex/
/.agents/
/.aws/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
/.npmrc
/.pypirc

# Artefatos temporarios e evidencias locais
/tmp/
/artifacts/
/test-results/
/playwright-report/
