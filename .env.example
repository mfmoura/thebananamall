APP_NAME="Loja"
MARCA_NOME="The Banana Mall"
APP_ENV=local
APP_KEY=
PASSWORD_PEPPER=
APP_DEBUG=true
APP_URL=http://localhost
# Token do agente ngrok para receber webhooks no ambiente local.
NGROK_AUTHTOKEN=
FRONTEND_URL=http://localhost
OAUTH_REDIRECT_URI=http://localhost/oauth/callback
BFF_CLIENT_ID=00000000-0000-4000-8000-000000000002
# Credencial gerada por php artisan bff:install. Nunca usar prefixo VITE_.
BFF_CLIENT_SECRET=
VITE_OAUTH_CLIENT_ID=00000000-0000-4000-8000-000000000001

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=default
DB_USERNAME=default
DB_PASSWORD=default

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=240

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CARRINHO_TTL=604800
CARRINHO_LOCK_TTL=120
CARRINHO_LOCK_WAIT=10

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
EMAIL_VERIFICATION_TTL=300
PASSWORD_RECOVERY_TTL=600
ADMIN_EMAIL=admin-teste@example.test
ADMIN_INITIAL_PASSWORD=

# Consulta pública de CEP via ViaCEP.
VIACEP_BASE_URL=https://viacep.com.br
VIACEP_TIMEOUT=8

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NFE.io: NF-e modelo 55, somente homologacao (IE Test).
NFE_IO_TOKEN=
NFE_IO_COMPANY_ID=
NFE_IO_STATE_TAX_ID=
NFE_IO_CNPJ=
NFE_IO_UF_EMITENTE=
NFE_IO_SERIE=1
NFE_IO_AMBIENTE=homologacao
NFE_IO_TIMEOUT=20
# Hosts exatos dos links assinados de XML, sem esquema nem caminho.
NFE_IO_DOWNLOAD_HOSTS=

# Ative temporariamente para investigar desempenho local.
TELESCOPE_ENABLED=true
TELESCOPE_RECORDING=false

CARRINHO_VISITANTE_TTL=86400
CARRINHO_CLIENTE_TTL=2592000
CARRINHO_RESERVA_TTL=900

MAIL_TIMEOUT=20

# Limites máximos; não representam memória pré-alocada.
DOCKER_PHP_MEMORY=1536m
DOCKER_HORIZON_MEMORY=1536m
DOCKER_NODE_MEMORY=1536m
DOCKER_DB_MEMORY=1024m
DOCKER_REDIS_MEMORY=768m
DOCKER_SCHEDULER_MEMORY=512m
DOCKER_NGINX_MEMORY=128m
DOCKER_NGROK_MEMORY=128m
NODE_HEAP_MB=1024
REDIS_MAXMEMORY=256mb
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Diagnóstico manual de cotação de frete (scripts/testar-hub-frete.php)
HUB_DESENVOLVEDOR_TOKEN=

FRETE_CEP_ORIGEM=03044000
