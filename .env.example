APP_NAME="Loja Virtual LCB"
APP_ENV=local
APP_KEY=
PASSWORD_PEPPER=
PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com/range
PWNED_PASSWORDS_TIMEOUT=4
PWNED_PASSWORDS_CACHE_MINUTES=60
APP_DEBUG=true
APP_URL=http://localhost
# Token do agente ngrok para receber webhooks no ambiente local.
NGROK_AUTHTOKEN=
FRONTEND_URL=http://localhost
OAUTH_REDIRECT_URI=http://localhost/oauth/callback
BFF_CLIENT_ID=00000000-0000-4000-8000-000000000002
# Credencial gerada por php artisan bff:install. Nunca usar prefixo VITE_.
BFF_CLIENT_SECRET=
VITE_OAUTH_CLIENT_ID=00000000-0000-4000-8000-000000000001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=default
DB_USERNAME=default
DB_PASSWORD=default

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=240

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CARRINHO_TTL=604800
CARRINHO_LOCK_TTL=120
CARRINHO_LOCK_WAIT=10

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
EMAIL_VERIFICATION_TTL=300
PASSWORD_RECOVERY_TTL=600
ADMIN_EMAIL=admin-teste@example.test
ADMIN_INITIAL_PASSWORD=

# Consulta pública de CEP via ViaCEP.
VIACEP_BASE_URL=https://viacep.com.br
VIACEP_TIMEOUT=8

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fiscal Contora: somente homologacao nesta primeira integracao.
FISCAL_CONTORA_TOKEN=
FISCAL_CONTORA_CNPJ=
FISCAL_CONTORA_AMBIENTE=homologacao
FISCAL_CONTORA_TIMEOUT=20
FISCAL_CONTORA_SERIE=1
FISCAL_CONTORA_UF_EMITENTE=
